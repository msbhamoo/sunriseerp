# Ignore CodeIgniter Cache and Logs
application/cache/*
!application/cache/index.html
application/logs/*
!application/logs/index.html

# Ignore user uploads (so you don't overwrite live uploads)
uploads/
backend/captcha_images/*
!backend/captcha_images/index.html

# Ignore database config if you have different local/live databases


# Ignore addons
/addons/
backup/database_backup/

# CI4 Specific Ignores
/vendor/
.env
writable/cache/*
!writable/cache/index.html
!writable/cache/.gitkeep
writable/debugbar/*
!writable/debugbar/index.html
!writable/debugbar/.gitkeep
writable/logs/*
!writable/logs/index.html
!writable/logs/.gitkeep
writable/session/*
!writable/session/index.html
!writable/session/.gitkeep
writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.gitkeep
